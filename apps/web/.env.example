# WalletConnect / Reown project id. Without it only injected wallets connect, and the UI says so.
# Public by design — it ships in the client bundle and identifies the app to the relay network, so
# it is not a secret. Get one at https://dashboard.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# Where the relayer is listening.
NEXT_PUBLIC_RELAYER_URL=http://localhost:8787

# Where the desk layer (apps/desk) is listening. Server-side only: the browser never sees it, because
# it never talks to it directly — next.config.mjs rewrites /api/desk/* to it, which keeps the session
# cookie same-origin.
DESK_URL=http://localhost:8788

# There is deliberately no API key here any more. The desk layer holds the relayer's key and answers
# each request from the manager's own signature, so this dashboard has nothing secret to ship.
