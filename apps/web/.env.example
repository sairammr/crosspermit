# WalletConnect / Reown project id. Without it only injected wallets connect, and the UI says so.
# Public by design — it ships in the client bundle and identifies the app to the relay network, so
# it is not a secret. Get one at https://dashboard.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# Where the relayer is listening.
NEXT_PUBLIC_RELAYER_URL=http://localhost:8787

# The desk's own key, needed to create and list client mandates when the relayer has
# RELAYER_API_KEYS set. This one IS a secret and it ships in the client bundle: this dashboard is
# the desk, so anyone who can open it can create client links. Put auth in front of the dashboard
# before exposing it, or leave this blank and drive mandates from the API.
NEXT_PUBLIC_RELAYER_API_KEY=
