# WalletConnect / Reown project id. Without it only injected wallets connect, and the UI says so.
# Public by design — it ships in the client bundle and identifies the app to the relay network, so
# it is not a secret. Get one at https://dashboard.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# Where the relayer is listening. Public: the client reads intent status straight from it.
NEXT_PUBLIC_RELAYER_URL=http://localhost:8787

# ---------------------------------------------------------------- the desk layer, server side only
# The desk used to be its own service on another port. It now runs inside this app, at /api/desk,
# which is why the session cookie is same-origin without a rewrite.

# The relayer, as the desk sees it. Never NEXT_PUBLIC_*: this one carries the key below.
RELAYER_URL=http://localhost:8787
# The relayer's admission key. Held here, never sent to a browser.
RELAYER_API_KEY=

# Where the desk keeps its tenancy: managers, sessions, nonces, client_links, desks. A hosted
# libSQL database, because this host has no durable filesystem. https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Set to 1 only for plain-http local development — it drops `Secure` from the session cookie.
DESK_INSECURE_COOKIE=
